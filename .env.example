# FrontRow environment template.
#
# Copy to `.env.local` and fill in. Next.js loads `.env.local` for the app;
# the CLI scripts (db:seed, db:reconcile, drizzle-kit) also read it via
# src/lib/load-env.ts. Access is lazy and per-subsystem (src/lib/env.ts):
# the availability endpoints only need DATABASE_URL + REDIS_URL, and the
# payment paths only need PAYSTACK_SECRET_KEY.

# ---------------------------------------------------------------------------
# Postgres (Drizzle ORM)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/frontrow

# ---------------------------------------------------------------------------
# Redis (temporary seat holds) - local docker, Upstash or Redis Cloud
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Paystack (Payments)
# Server-only. Checkout redirects to Paystack's hosted page, so no browser-side
# public key is required.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seat hold lifetime in seconds. 600 = 10 minutes.
HOLD_TTL_SECONDS=600
# Marketplace service fee, in basis points (750 = 7.5%).
PLATFORM_FEE_BPS=750
